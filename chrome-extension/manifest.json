{
  "manifest_version": 3,
  "name": "Legacy Loop Oracle",
  "version": "1.0.0",
  "description": "Your friendly autonomous AI software architect. Understand codebase changes in simple language directly from GitHub.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Oracle Chat"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
